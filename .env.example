# Токен бота от @BotFather
BOT_TOKEN=

# Юзернейм тренера (без @) — сюда ведёт кнопка "Написать мне для оплаты"
# на карточке товара (deep-link вида https://t.me/<username>?text=...).
TRAINER_USERNAME=Tolmachev92

# chat_id тренера в Telegram — нужен, чтобы команда /broadcast (рассылка
# по всем пользователям бота) работала только у тренера.
# Как получить: тренер пишет боту /whoami, бот пришлёт chat_id — впишите его сюда.
TRAINER_CHAT_ID=

# file_id фотографии для приветственного сообщения (/start).
# По умолчанию уже подставлен актуальный file_id — менять не обязательно.
WELCOME_PHOTO_ID=AgACAgIAAxkBAANHap3abUBoWdf-BSPQxJcHDiLAzXEAAqEoaxtrt_FIX-xsL-BazEgBAAMCAAN5AAM9BA
